# AI Service Keys (At least one is required)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Configuration
POSTGRES_DB=interview_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/interview_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
JWT_SECRET=your_64_character_super_secure_jwt_secret_key_string_goes_here_min_64
AI_SERVICE_URL=http://localhost:8000
GOOGLE_OAUTH_CLIENT_ID=878245794947-aidf981hqs97v7j5emsnrrdoos5lmk7e.apps.googleusercontent.com

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
